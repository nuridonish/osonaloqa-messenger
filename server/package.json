{
  "name": "@osonaloqa/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OSON ALOQA messenger backend — Fastify + WebSocket",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "e2e": "tsx test/e2e.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.11.17",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
